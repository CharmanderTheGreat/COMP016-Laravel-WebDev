            upper:  (v) => /[A-Z]/.test(v),
            lower:  (v) => /[a-z]/.test(v),
            number: (v) => /[0-9]/.test(v),
            symbol: (v) => /[^A-Za-z0-9]/.test(v),
            match:  (v) => v.length > 0 && v === confirmPw.value,
